<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="inmopolt_create_subscription_invoices_as" model="ir.actions.server">
            <field name="name">=> Crear recibos de inquilinos que no tienen facturas borrador</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">
model.inmopolt_create_subscription_invoices()
            </field>
        </record>

        <record id="inmopolt_auto_reconcile_paid_invoices_as" model="ir.actions.server">
            <field name="name">=> AS Autovalidación de facturas pagadas (sin tener que reconciliar)</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="base_automation_id" ref="inmopolt_auto_reconcile_paid_invoices_aa"/>
            <field name="state">code</field>
            <field name="code">
record.inmopolt_auto_reconcile_paid_invoices()
            </field>
        </record>

    </data>

</odoo>
